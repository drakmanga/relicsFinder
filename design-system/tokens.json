{
  "$description": "Relic Finder — Orokin Design System. W3C DTCG format. Dark-only, desktop-first.",
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Void blacks — base canvas and text-on-light-fill.",
      "950": { "$value": "#0B0A08" },
      "900": { "$value": "#131210" },
      "800": { "$value": "#1A1815" },
      "700": { "$value": "#23201A" },
      "600": { "$value": "#2B2720" },
      "500": { "$value": "#3A3529" }
    },
    "bone": {
      "$description": "Warm neutrals for foreground text.",
      "50": { "$value": "#F2EDE3" },
      "200": { "$value": "#D6CFC2" },
      "300": { "$value": "#B9B1A2" },
      "400": { "$value": "#9A9280" },
      "500": { "$value": "#6E6757" },
      "600": { "$value": "#5C5648" }
    },
    "gold": {
      "$description": "Orokin gold — brand, primary action, Rare rarity, Radiant refinement.",
      "50": { "$value": "#FBF3D9" },
      "100": { "$value": "#F5E4AF" },
      "200": { "$value": "#F0CC66" },
      "300": { "$value": "#E3B341" },
      "400": { "$value": "#D4A32F" },
      "500": { "$value": "#C9A227" },
      "600": { "$value": "#A08428" },
      "700": { "$value": "#8A7423" },
      "800": { "$value": "#5E4A13" },
      "900": { "$value": "#3A2D0C" }
    },
    "void": {
      "$description": "Void purple — UI accent: links, focus, selection, secondary action.",
      "100": { "$value": "#DCD2FD" },
      "200": { "$value": "#C4B4FA" },
      "300": { "$value": "#B7A3F7" },
      "400": { "$value": "#9B82F0" },
      "500": { "$value": "#7C5CE6" },
      "600": { "$value": "#6647D6" },
      "700": { "$value": "#4E2FBF" },
      "800": { "$value": "#3D24A0" },
      "900": { "$value": "#2B1970" }
    },
    "signal": {
      "$description": "Semantic feedback.",
      "success": { "$value": "#5FBF7F" },
      "success-dim": { "$value": "#2E6B45" },
      "warning": { "$value": "#E0A63C" },
      "warning-dim": { "$value": "#6B4E14" },
      "danger": { "$value": "#F07A75" },
      "danger-solid": { "$value": "#A32B27" },
      "info": { "$value": "#6BBEE0" },
      "info-dim": { "$value": "#22505F" }
    },
    "tier": {
      "$description": "Relic era. Applied as filled chip only — never as text on dark.",
      "lith": { "$value": "#6BBEE0" },
      "meso": { "$value": "#7FBF6A" },
      "neo": { "$value": "#DB9463" },
      "axi": { "$value": "#DE8CE8" },
      "requiem": { "$value": "#B9B1A2" },
      "vanguard": { "$value": "#9AA6EE" }
    },
    "rarity": {
      "$description": "Drop rarity metals. Applied as dot + text in the drop column only.",
      "common": { "$value": "#C97F3E" },
      "uncommon": { "$value": "#B8BFC7" },
      "rare": { "$value": "#E3B341" }
    },
    "currency": {
      "platinum": { "$value": "#B8C9D9" },
      "ducat": { "$value": "#D9B87A" },
      "credit": { "$value": "#9A9280" }
    }
  },

  "semantic": {
    "$type": "color",
    "surface": {
      "0": { "$value": "{color.ink.950}", "$description": "App canvas" },
      "1": { "$value": "{color.ink.900}", "$description": "Panels, table body" },
      "2": { "$value": "{color.ink.800}", "$description": "Cards, table header, inputs" },
      "3": { "$value": "{color.ink.700}", "$description": "Hover fills, popovers" },
      "4": { "$value": "{color.ink.600}", "$description": "Dialogs, dropdowns" },
      "inverse": { "$value": "{color.bone.50}" },
      "scrim": { "$value": "#0B0A08CC" }
    },
    "fg": {
      "primary": { "$value": "{color.bone.50}" },
      "secondary": { "$value": "{color.bone.300}" },
      "muted": { "$value": "{color.bone.400}" },
      "disabled": { "$value": "{color.bone.600}" },
      "on-gold": { "$value": "{color.ink.950}" },
      "on-void": { "$value": "{color.bone.50}" },
      "on-inverse": { "$value": "{color.ink.950}" },
      "brand": { "$value": "{color.gold.300}" },
      "accent": { "$value": "{color.void.400}" },
      "link": { "$value": "{color.void.400}" },
      "link-hover": { "$value": "{color.void.300}" }
    },
    "border": {
      "subtle": { "$value": "#221F19", "$description": "Decorative hairlines, table dividers" },
      "default": { "$value": "#2E2920" },
      "strong": { "$value": "#4A4030" },
      "interactive": { "$value": "{color.gold.700}", "$description": "Boundaries of controls — 3:1 verified" },
      "emphasis": { "$value": "{color.gold.600}" },
      "focus": { "$value": "{color.void.400}" },
      "danger": { "$value": "{color.signal.danger}" }
    },
    "action": {
      "primary-bg": { "$value": "{color.gold.500}" },
      "primary-bg-hover": { "$value": "{color.gold.400}" },
      "primary-bg-active": { "$value": "{color.gold.600}" },
      "primary-fg": { "$value": "{color.ink.950}" },
      "accent-bg": { "$value": "{color.void.700}" },
      "accent-bg-hover": { "$value": "{color.void.600}" },
      "accent-bg-active": { "$value": "{color.void.800}" },
      "accent-fg": { "$value": "{color.bone.50}" },
      "ghost-bg-hover": { "$value": "#C9A2270F" },
      "danger-bg": { "$value": "{color.signal.danger-solid}" },
      "danger-fg": { "$value": "{color.bone.50}" },
      "disabled-bg": { "$value": "{color.ink.700}" },
      "disabled-fg": { "$value": "{color.bone.600}" }
    },
    "state": {
      "row-hover": { "$value": "#C9A2270D" },
      "row-selected": { "$value": "#7C5CE61A" },
      "row-marker-hover": { "$value": "{color.gold.500}" },
      "row-marker-selected": { "$value": "{color.void.400}" },
      "gold-veil-8": { "$value": "#C9A22714" },
      "gold-veil-16": { "$value": "#C9A22729" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Cinzel", "Georgia", "Times New Roman", "serif"] },
      "ui": { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] },
      "data": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Always with font-variant-numeric: tabular-nums" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "display-xl": { "$value": "48px" },
      "display-lg": { "$value": "36px" },
      "display-md": { "$value": "28px" },
      "display-sm": { "$value": "22px" },
      "heading-lg": { "$value": "18px" },
      "heading-md": { "$value": "16px" },
      "heading-sm": { "$value": "14px" },
      "body-lg": { "$value": "16px" },
      "body-md": { "$value": "15px" },
      "body-sm": { "$value": "13px" },
      "caption": { "$value": "12px" },
      "overline": { "$value": "11px" },
      "data-lg": { "$value": "20px" },
      "data-md": { "$value": "14px" },
      "data-sm": { "$value": "13px" }
    },
    "lineHeight": {
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.2 },
      "normal": { "$value": 1.45 },
      "relaxed": { "$value": 1.6 },
      "data": { "$value": 1.2 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "0.01em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em" },
      "overline": { "$value": "0.12em" }
    }
  },

  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" }
  },

  "notch": {
    "$type": "dimension",
    "$description": "Orokin corner cut depth. Replaces border-radius — radius is 0 everywhere.",
    "xs": { "$value": "4px" },
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" }
  },

  "border": {
    "$type": "dimension",
    "width": {
      "hairline": { "$value": "1px" },
      "frame": { "$value": "1px" },
      "emphasis": { "$value": "2px" },
      "focus": { "$value": "2px" },
      "marker": { "$value": "2px" }
    },
    "radius": {
      "none": { "$value": "0px", "$description": "Default for every surface" },
      "full": { "$value": "9999px", "$description": "Only for dots, avatars, spinner" }
    }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" },
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "280ms" },
      "sweep": { "$value": "420ms" },
      "pulse": { "$value": "2400ms" },
      "stagger-step": { "$value": "40ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] },
      "enter": { "$value": [0, 0.6, 0.3, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] },
      "orokin": { "$value": [0.16, 1, 0.3, 1] }
    }
  },

  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "dropdown": { "$value": 1000 },
    "overlay": { "$value": 1100 },
    "modal": { "$value": 1200 },
    "toast": { "$value": 1300 },
    "tooltip": { "$value": 1400 }
  },

  "size": {
    "$type": "dimension",
    "control": {
      "xs": { "$value": "24px" },
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "48px" }
    },
    "icon": {
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" }
    },
    "row": {
      "compact": { "$value": "32px" },
      "default": { "$value": "40px" },
      "comfortable": { "$value": "48px" }
    },
    "layout": {
      "sidebar": { "$value": "260px" },
      "detail-panel": { "$value": "380px" },
      "topbar": { "$value": "56px" },
      "container-max": { "$value": "1600px" },
      "table-min": { "$value": "640px" }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
