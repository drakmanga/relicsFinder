{
  "projectId": "82b30910-ffd9-4ff8-987b-1d568f7e1fd1",
  "shape": "package",
  "pkg": "relic-finder-ui",
  "globalName": "RelicFinderUI",
  "buildCmd": "npm run build:ui",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": "dist/styles.css",
  "extraFonts": ["dist/styles.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "provider": {
    "component": "OrokinProvider",
    "props": { "fullHeight": true }
  },
  "overrides": {
    "Dialog": { "cardMode": "single", "primaryStory": "AddToInventory", "viewport": "900x620" },
    "Tooltip": { "cardMode": "column", "viewport": "900x320" },
    "Table": { "cardMode": "column", "viewport": "1100x560" },
    "DetailPanel": { "cardMode": "column", "viewport": "560x900" },
    "Frame": { "cardMode": "column" },
    "Card": { "cardMode": "column" },
    "OrokinProvider": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "LithGlyph": null,
    "MesoGlyph": null,
    "NeoGlyph": null,
    "AxiGlyph": null,
    "RequiemGlyph": null,
    "CommonGlyph": null,
    "UncommonGlyph": null,
    "RareGlyph": null,
    "PlatinumGlyph": null,
    "DucatGlyph": null,
    "VoidSigil": null,
    "SearchIcon": null,
    "SearchXIcon": null,
    "ExternalLinkIcon": null,
    "AlertTriangleIcon": null,
    "XIcon": null,
    "ArrowUpDownIcon": null,
    "ArrowUpIcon": null,
    "ArrowDownIcon": null
  }
}
