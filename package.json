{
  "name": "relic-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Relic Finder — Orokin design system, component library and web frontend",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=relic-finder-ui && npm run build --workspace=@relic-finder/web",
    "build:ui": "npm run build --workspace=relic-finder-ui",
    "dev": "npm run dev --workspace=@relic-finder/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run verify --workspace=relic-finder-ui",
    "lint": "eslint .",
    "lint:debt": "node scripts/lint-debt.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:all": "npm run typecheck && npm run lint && npm run lint:debt && npm run verify",
    "axe": "node scripts/axe-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
